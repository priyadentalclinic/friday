{
  "expo": {
    "name": "FRIDAY",
    "slug": "friday-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.friday.ai",
      "newArchEnabled": true,
      "permissions": [
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "plugins": [
        [
          "expo-speech-recognition",
          {
            "microphonePermission": "Allow FRIDAY to access the microphone for speech recognition.",
            "speechRecognitionPermission": "Allow FRIDAY to use speech recognition."
          }
        ]
      ]
    },
    "extra": {
      "eas": {
        "projectId": "db9d92de-f3aa-4e72-a33d-005ed5a305a5"
      }
    }
  }
}
